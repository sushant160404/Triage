# ---------- Secrets ----------
# Real env files hold the Groq API key — never commit them.
# .env.example is intentionally NOT ignored, so the template stays tracked.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ---------- Node (server/) ----------
node_modules/
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ---------- Cordova ----------
# platforms/ and plugins/ are regenerated by `cordova platform add` /
# `cordova plugin add` from config.xml — don't commit the generated output.
platforms/
plugins/
.cordova/
hooks/
cordova-build/*.apk
cordova-build/*.ipa
*.apk
*.ipa
*.aab

# ---------- Editors / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log
